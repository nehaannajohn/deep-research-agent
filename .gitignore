# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Env / secrets
.env
.env.*
!.env.example
*.key

# Models / data artifacts (large)
models/
checkpoints/
*.bin
*.safetensors
data/raw/
data/cache/
# Offline eval harness artifacts — ignored EXCEPT the curated DRA-Bench prompt set
# (the benchmark definition: small, reviewed, reproducible — tracked so eval runs
# on any host have their inputs). Large generated artifacts stay ignored.
/eval/*
!/eval/dra_bench/
/eval/dra_bench/*
!/eval/dra_bench/prompts.jsonl
!/eval/dra_bench/prompts_review.md

# OS / editor
.DS_Store
.idea/
.vscode/

# Logs / runs
*.log
runs/
wandb/
outputs/

# The assessment PDF (keep local, not in the shared code repo)
*.pdf

# Internal planning / design docs — kept local, not part of the code package
CLAUDE.md
docs/*
# ...except the consolidated research & experiments docs (incl. their PDFs, overriding *.pdf above)
!docs/research-and-experiments/
!docs/research-and-experiments/**
