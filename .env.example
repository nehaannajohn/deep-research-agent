# Copy to .env and fill in real values. .env is gitignored — NEVER commit real keys.

# ===== AWS Bedrock — LLMs for synthesis, in-loop judge verifier, evaluation judge panel =====
AWS_REGION=us-east-1
# Auth — use ONE method; leave the other lines commented.
# Empty values here break botocore's credential chain, so don't leave blank keys.
# (a) named profile (recommended, esp. for SSO):
# AWS_PROFILE=your-profile
# (b) static keys:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Bedrock model IDs by ROLE — keep families DISTINCT for model independence.
# Verify the exact IDs available in your region/account before use.
# Modern models need their INFERENCE-PROFILE id (us./global. prefix), not the bare id.
# Generator = Llama 4 Maverick: per the generator-comparison experiment it produces the
# best-grounded, most atomic, most concise claims (beats Mistral Large 3 on grounding,
# unanimous across a 3-judge panel). Mistral moves to the in-loop verifier role.
BEDROCK_GENERATOR_MODEL=us.meta.llama4-maverick-17b-instruct-v1:0
BEDROCK_INLOOP_JUDGE_MODEL=mistral.mistral-large-3-675b-instruct
BEDROCK_PANEL_MODELS=openai.gpt-oss-120b-1:0,global.anthropic.claude-opus-4-8,us.deepseek.r1-v1:0
# Optional: dedicated model for diagram generation (defaults to the generator if unset)
# BEDROCK_DIAGRAM_MODEL=
# Verifier ensemble (model-independent of the generator) — used by the verifier experiment.
# Modern models need their inference-profile id (us./global. prefix). Confirm exact Bedrock ids.
BEDROCK_VERIFIER_MODELS=global.anthropic.claude-sonnet-4-6,mistral.mistral-large-3-675b-instruct,us.amazon.nova-pro-v1:0

# ===== Retrieval tools — free tiers for the bake-off; upgrade only the winner =====
# Default backend is Exa (chosen by the Phase-1 bake-off). Keep keys on their own
# line with NO inline comment — dotenv parses an inline comment as the value.
EXA_API_KEY=
TAVILY_API_KEY=
# Semantic Scholar is optional (works key-less but rate-limited; not used by default).
SEMANTIC_SCHOLAR_API_KEY=

# ===== External baseline =====
PERPLEXITY_API_KEY=

# ===== Experiment tracking (optional) =====
WANDB_API_KEY=
